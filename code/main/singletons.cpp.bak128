#include <main/singletons.h>

#ifdef RAD_PSP
#include <pspiofilemgr.h>
#include <cstdarg>
static SceUID g_sing_log = -1;
static void SLog(const char* fmt, ...) {
    if (g_sing_log < 0) {
        g_sing_log = sceIoOpen("ms0:/hitr_singletons.log",
                                PSP_O_WRONLY | PSP_O_CREAT | PSP_O_TRUNC, 0777);
        if (g_sing_log < 0) return;
    }
    char buf[256];
    va_list a;
    va_start(a, fmt);
    vsnprintf(buf, sizeof(buf), fmt, a);
    va_end(a);
    int len = 0; while (buf[len]) len++;
    sceIoWrite(g_sing_log, buf, len);
}
#define SLOG(x) SLog(x "\n")
#else
#define SLOG(x) ((void)0)
#endif

